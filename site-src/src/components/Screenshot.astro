---
// A product screenshot: optimised via astro:assets, framed, optionally
// captioned, and linked to the full-size image. Screenshots live in
// src/assets/screenshots/ and are captured from a live demo instance.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	/** Portrait shots (login, setup) that would be oversized at full column width. */
	narrow?: boolean;
}

const { src, alt, caption, narrow = false } = Astro.props;
// Screenshots are native 1920x1080 captures (or crops of one). Keep them lossless PNG and never
// upscale: offer a 960px variant for small screens plus the original width.
const widths = [...new Set([960, src.width].filter((w) => w <= src.width))];
---

<figure class:list={['rs-shot', { 'rs-shot--narrow': narrow }]}>
	<a href={src.src} target="_blank" rel="noopener" aria-label={`${alt} (open full size)`}>
		<Image src={src} alt={alt} format="png" widths={widths} sizes={narrow ? "32rem" : "(min-width: 72rem) 45rem, 100vw"} />
	</a>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
