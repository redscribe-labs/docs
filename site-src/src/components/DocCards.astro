---
// Link cards for the docs home. Each card: optional eyebrow, icon, title, description, link.
interface Card { href: string; title: string; body: string; icon?: keyof typeof ICONS; eyebrow?: string }
interface Props { cards: Card[]; columns?: 1 | 2 | 3 | 4; /** Compact rows instead of tall cards. */ compact?: boolean }

const ICONS = {
	rocket: '<path d="M5 15c-1.5 1.5-2 4-2 4s2.5-.5 4-2m3.5-2.5L7.5 11.5M14 4c3 0 6 3 6 6l-6 6-6-6 6-6Z"/><circle cx="14.5" cy="9.5" r="1.5"/>',
	server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
	key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 2 2m-4 0 2 2"/>',
	book: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19a2 2 0 0 1 2-2h13"/>',
	bug: '<rect x="7" y="7" width="10" height="12" rx="5"/><path d="M12 7V4m-5 7H3m18 0h-4M7 16H4m16 0h-3M9 5l1.5 2m4.5-2-1.5 2"/>',
	check: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8 12 3 3 5-6"/>',
	users: '<circle cx="9" cy="8" r="3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><circle cx="17" cy="9" r="2.2"/><path d="M16 14.2a4 4 0 0 1 5 3.8v1"/>',
	shield: '<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
	portal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h4"/>',
	cog: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M2 12h3m14 0h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
	ship: '<path d="M3 17h18l-2 4H5l-2-4ZM6 17V9h12v8M9 9V5h6v4"/>',
	code: '<path d="m8 8-4 4 4 4m8-8 4 4-4 4M14 5l-4 14"/>',
	list: '<path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/>',
	file: '<path d="M6 3h8l4 4v14H6V3Z"/><path d="M14 3v4h4M9 13h6M9 17h6"/>',
} as const;

const { cards, columns = 3, compact = false } = Astro.props;
---

<ul class:list={['rs-cards not-content', { 'rs-cards--compact': compact }]} style={`--cols: ${columns}`}>
	{cards.map((c) => (
		<li>
			<a href={c.href} class="rs-card">
				{c.icon && (
					<span class="rs-card__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon]} />
					</span>
				)}
				{c.eyebrow && <span class="rs-card__eyebrow">{c.eyebrow}</span>}
				<span class="rs-card__title">{c.title} <span class="rs-card__arrow" aria-hidden="true">→</span></span>
				<span class="rs-card__body">{c.body}</span>
			</a>
		</li>
	))}
</ul>

<style>
	.rs-cards {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: 0.9rem;
	}
	.rs-card {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.35rem 1.4rem 1.45rem;
		border-radius: 16px;
		border: 1px solid var(--sl-color-gray-5);
		background: linear-gradient(180deg, color-mix(in srgb, var(--sl-color-gray-6) 85%, transparent), transparent);
		text-decoration: none;
		transition: border-color 150ms ease, transform 150ms ease, background 150ms ease;
	}
	.rs-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
	}
	.rs-card__icon {
		display: inline-flex;
		width: 2.4rem;
		height: 2.4rem;
		margin-bottom: 0.35rem;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
		color: var(--sl-color-accent);
	}
	.rs-card__icon svg {
		width: 1.3rem;
		height: 1.3rem;
	}
	.rs-card__eyebrow {
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-accent);
	}
	.rs-card__title {
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
	}
	.rs-card__arrow {
		display: inline-block;
		color: var(--sl-color-accent);
		transition: transform 150ms ease;
	}
	.rs-card:hover .rs-card__arrow {
		transform: translateX(3px);
	}
	.rs-card__body {
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
	.rs-cards--compact {
		gap: 0.5rem;
	}
	.rs-cards--compact .rs-card {
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 0.85rem;
		row-gap: 0.15rem;
		align-items: start;
		padding: 0.85rem 1rem;
		border-radius: 12px;
		background: transparent;
	}
	.rs-cards--compact .rs-card:hover {
		transform: none;
		background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
	}
	.rs-cards--compact .rs-card__icon {
		grid-row: span 3;
		width: 2rem;
		height: 2rem;
		margin: 0.1rem 0 0;
		border-radius: 8px;
	}
	.rs-cards--compact .rs-card__icon svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	.rs-cards--compact .rs-card__title {
		font-size: 1rem;
	}
	.rs-cards--compact .rs-card__eyebrow {
		font-size: 0.68rem;
	}
	@media (max-width: 60rem) {
		.rs-cards {
			grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
		}
	}
	@media (max-width: 36rem) {
		.rs-cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
