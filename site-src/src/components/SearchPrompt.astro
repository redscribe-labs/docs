---
// A large search field for the docs home that opens Starlight's own search dialog.
---

<button type="button" class="rs-search-prompt not-content" data-rs-search>
	<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
	<span>Search the docs</span>
	<kbd>Ctrl</kbd><kbd>K</kbd>
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-rs-search]').forEach((btn) =>
		btn.addEventListener('click', () => {
			document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
		}),
	);
</script>

<style>
	.rs-search-prompt {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		margin-top: 1.75rem;
		padding: 0.95rem 1.1rem;
		border-radius: 12px;
		border: 1px solid var(--sl-color-gray-5);
		background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		color: var(--sl-color-gray-3);
		font: inherit;
		font-size: var(--sl-text-base);
		text-align: start;
		cursor: pointer;
		transition: border-color 150ms ease;
	}
	.rs-search-prompt:hover {
		border-color: var(--sl-color-accent);
	}
	.rs-search-prompt span {
		flex: 1;
	}
	kbd {
		padding: 0.1rem 0.45rem;
		border-radius: 6px;
		border: 1px solid var(--sl-color-gray-5);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
	}
</style>
